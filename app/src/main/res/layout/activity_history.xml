<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_gradient_start">

    <!-- Modern Gradient Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@drawable/gradient_header"
        android:elevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/backButton"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_back_arrow"
                android:padding="6dp"
                android:contentDescription="Back"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/white" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Session History"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginStart="12dp" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/dateRangeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="All Time"
                android:textSize="12sp"
                android:textColor="@color/white_80"
                android:layout_marginEnd="16dp" />
        </LinearLayout>

    </androidx.appcompat.widget.Toolbar>

    <!-- Modern Stats Row - 3 Cards -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center">

        <!-- Total Sessions Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/card_bg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📊"
                    android:textSize="28sp" />

                <TextView
                    android:id="@+id/totalSessionsCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total Sessions"
                    android:textSize="11sp"
                    android:textColor="@color/text_secondary" />

                <View
                    android:layout_width="40dp"
                    android:layout_height="3dp"
                    android:background="@color/primary"
                    android:layout_marginTop="8dp"
                    app:cardCornerRadius="2dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Total Hours Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/card_bg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⏱️"
                    android:textSize="28sp" />

                <TextView
                    android:id="@+id/totalHoursCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="@color/success"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total Hours"
                    android:textSize="11sp"
                    android:textColor="@color/text_secondary" />

                <View
                    android:layout_width="40dp"
                    android:layout_height="3dp"
                    android:background="@color/success"
                    android:layout_marginTop="8dp"
                    app:cardCornerRadius="2dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Average Hours Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/card_bg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⭐"
                    android:textSize="28sp" />

                <TextView
                    android:id="@+id/averageHoursCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="@color/warning"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Avg Hours"
                    android:textSize="11sp"
                    android:textColor="@color/text_secondary" />

                <View
                    android:layout_width="40dp"
                    android:layout_height="3dp"
                    android:background="@color/warning"
                    android:layout_marginTop="8dp"
                    app:cardCornerRadius="2dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <!-- Quick Stats Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📈 "
            android:textSize="12sp" />

        <TextView
            android:id="@+id/bestDayText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Best day: Not enough data"
            android:textSize="12sp"
            android:textColor="@color/text_secondary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🏆 "
            android:textSize="12sp" />

        <TextView
            android:id="@+id/mostProductiveText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Most productive: -"
            android:textSize="12sp"
            android:textColor="@color/text_secondary" />
    </LinearLayout>

    <!-- Filter Section Title with Icon -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎯"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" Filter Sessions"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <!-- Modern Filter Chips Row 1 - Time Filters -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="12dp"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/dayFilterChipGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:chipSpacing="10dp"
            app:singleLine="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipAllDays"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="All"
                android:checked="true"
                app:chipBackgroundColor="@color/primary"
                android:textColor="@color/white"
                app:chipIcon="@android:drawable/ic_menu_view"
                app:chipIconTint="@color/white" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipToday"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Today"
                app:chipBackgroundColor="@color/chip_unselected"
                android:textColor="@color/text_primary"
                app:chipIcon="@android:drawable/ic_menu_today"
                app:chipIconTint="@color/text_primary" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipYesterday"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Yesterday"
                app:chipBackgroundColor="@color/chip_unselected"
                android:textColor="@color/text_primary" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipThisWeek"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="This Week"
                app:chipBackgroundColor="@color/chip_unselected"
                android:textColor="@color/text_primary"
                app:chipIcon="@android:drawable/ic_menu_week"
                app:chipIconTint="@color/text_primary" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipThisMonth"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="This Month"
                app:chipBackgroundColor="@color/chip_unselected"
                android:textColor="@color/text_primary"
                app:chipIcon="@android:drawable/ic_menu_month"
                app:chipIconTint="@color/text_primary" />

        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- Modern Filter Chips Row 2 - Weekday Filters -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="16dp"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/weekdayFilterChipGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:chipSpacing="10dp"
            app:singleLine="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipMonday"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mon"
                app:chipBackgroundColor="@color/chip_unselected"
                android:textColor="@color/text_primary" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipTuesday"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tue"
                app:chipBackgroundColor="@color/chip_unselected"
                android:textColor="@color/text_primary" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipWednesday"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Wed"
                app:chipBackgroundColor="@color/chip_unselected"
                android:textColor="@color/text_primary" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipThursday"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Thu"
                app:chipBackgroundColor="@color/chip_unselected"
                android:textColor="@color/text_primary" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipFriday"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fri"
                app:chipBackgroundColor="@color/chip_unselected"
                android:textColor="@color/text_primary" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipSaturday"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sat"
                app:chipBackgroundColor="@color/chip_unselected"
                android:textColor="@color/text_primary" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipSunday"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sun"
                app:chipBackgroundColor="@color/chip_unselected"
                android:textColor="@color/text_primary" />

        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- Session List Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="12dp"
        android:background="@color/background">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📋 Study Sessions"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/sessionCountText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 items"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:background="@color/chip_unselected"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            app:cardCornerRadius="12dp" />
    </LinearLayout>

    <!-- RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/historyRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="12dp"
        android:paddingBottom="16dp"
        android:clipToPadding="false" />

    <!-- Modern Empty State View -->
    <LinearLayout
        android:id="@+id/emptyState"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone">

        <androidx.cardview.widget.CardView
            android:layout_width="120dp"
            android:layout_height="120dp"
            app:cardCornerRadius="60dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/primary_light">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📭"
                    android:textSize="48sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No Study Sessions"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginTop="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Start tracking your study journey"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:gravity="center"
            android:layout_marginTop="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGoToAdd"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:text="+ Add Study Session"
            android:textSize="14sp"
            android:textStyle="bold"
            app:cornerRadius="26dp"
            app:backgroundTint="@color/primary"
            android:icon="@android:drawable/ic_input_add"
            android:iconTint="@color/white" />
    </LinearLayout>

</LinearLayout>